# Gateway server
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080


# C++ matching engine
ENGINE_HOST=127.0.0.1
ENGINE_PORT=9000
ENGINE_CONNECT_TIMEOUT_MS=5000
ENGINE_REQUEST_TIMEOUT_MS=5000
ENGINE_RECONNECT_INITIAL_DELAY_MS=500
ENGINE_RECONNECT_MAX_DELAY_MS=10000
ENGINE_RECONNECT_MAX_ATTEMPTS=10

# Python analytics service
ANALYTICS_HOST=127.0.0.1
ANALYTICS_PORT=8000
ANALYTICS_REQUEST_TIMEOUT_MS=5000

# WebSocket
WEBSOCKET_PATH=/ws
WEBSOCKET_HEARTBEAT_INTERVAL_MS=30000
WEBSOCKET_MAX_PAYLOAD_BYTES=1048576
WEBSOCKET_MAX_QUEUE_SIZE=256

# HTTP
HTTP_REQUEST_TIMEOUT_MS=10000
HTTP_BODY_LIMIT_BYTES=1048576

# Logging
LOG_LEVEL=info

# Metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics

# CORS
CORS_ORIGIN=http://localhost:5173

